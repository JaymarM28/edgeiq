# Copiar a .env y ajustar valores para desarrollo local / docker compose.
NODE_ENV=development

POSTGRES_USER=edgeiq
POSTGRES_PASSWORD=edgeiq
POSTGRES_DB=edgeiq
# Puerto 5433 (no 5432) en el host: docker-compose.override.yml mapea
# Postgres a 5433 para evitar chocar con un Postgres nativo en 5432. Dentro
# de la red de Docker el api se conecta vía "postgres:5432" (sin cambios).
DATABASE_URL=postgresql://edgeiq:edgeiq@localhost:5433/edgeiq

REDIS_URL=redis://localhost:6379

API_PORT=4000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Dominio(s) permitidos por CORS en la API, separados por coma (ej.
# https://edgeiq.vercel.app). Vacío en dev = cualquier origen permitido;
# en producción, configúralo siempre al dominio real del frontend.
CORS_ORIGIN=

# API-Football (api-football.com) — plan Pro (la temporada actual no está
# disponible en el plan Free, ver docs/DECISIONS.md)
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
# Qué ligas seguir y en qué temporada ya no se configura acá: ver
# apps/api/src/domain/ingestion/leagues.config.ts (código versionado, se
# resuelve por nombre+país contra la API, temporada siempre automática).
VALUE_BET_EDGE_THRESHOLD=0.02

# Auth (JWT) — obligatorio en producción; en dev cae a un default inseguro
# si se deja vacío (ver apps/api/src/domain/auth/auth.module.ts).
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Groq (LLM para explicaciones de value bets y análisis de partidos)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Resend (emails transaccionales: reset de password, etc.)
RESEND_API_KEY=
EMAIL_FROM=EdgeIQ <noreply@example.com>

# Notificaciones de value bets (opcional, ambos canales son best-effort)
NOTIFY_EMAIL=
CALLMEBOT_PHONE=
CALLMEBOT_API_KEY=
